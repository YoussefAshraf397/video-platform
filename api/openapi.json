        "/auth/refresh": {
            "post": {
                "operationId": "auth.refresh",
                "summary": "Exchanges the refresh-token cookie for a new access token and a new refresh token",
                "tags": [
                    "Auth"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "access_token": {
                                            "anyOf": [
                                                {
                                                    "type": "string"
                                                },
                                                {}
                                            ]
                                        },
                                        "token_type": {
                                            "anyOf": [
                                                {
                                                    "type": "string",
                                                    "const": "Bearer"
                                                },
                                                {}
                                            ]
                                        },
                                        "expires_in": {
                                            "anyOf": [
                                                {
                                                    "type": "integer"
                                                },
                                                {}
