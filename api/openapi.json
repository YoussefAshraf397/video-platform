{
    "openapi": "3.1.0",
    "info": {
        "title": "Video Platform API",
        "version": "0.0.1"
    },
    "servers": [
        {
            "url": "http://localhost:8000/v1"
        }
    ],
    "paths": {
        "/auth/register": {
            "post": {
                "operationId": "auth.register",
                "summary": "Always 202, whether or not the email is already registered (no account enumeration)",
                "tags": [
                    "Auth"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "maxLength": 254
                                    },
                                    "password": {
                                        "type": "string",
                                        "minLength": 10,
                                        "maxLength": 128
                                    },
                                    "display_name": {
                                        "type": "string",
                                        "maxLength": 100
                                    }
                                },
                                "required": [
                                    "email",
                                    "password",
                                    "display_name"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "202": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "const": "Check your email to continue."
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "type": {
                                            "type": "string",
                                            "description": "URI identifying the problem type."
                                        },
                                        "title": {
                                            "type": "string"
                                        },
                                        "status": {
                                            "type": "integer",
                                            "examples": [
                                                422
                                            ]
                                        },
                                        "detail": {
                                            "type": "string"
                                        },
                                        "code": {
                                            "type": "string",
                                            "description": "Stable machine-readable error code."
                                        },
                                        "request_id": {
                                            "type": "string"
                                        },
                                        "errors": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "field": {
                                                        "type": "string"
                                                    },
                                                    "code": {
                                                        "type": "string"
                                                    },
                                                    "message": {
                                                        "type": "string"
                                                    }
                                                },
                                                "required": [
                                                    "field",
                                                    "code",
                                                    "message"
                                                ]
                                            }
                                        }
                                    },
                                    "required": [
                                        "type",
                                        "title",
                                        "status",
                                        "code"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
