{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.video-platform.internal/video-processing-completed.v1.json",
  "title": "VideoProcessingCompleted",
  "description": "From the media worker (queue: media-results): every rendition, the master playlist and thumbnails are written.",
  "allOf": [{ "$ref": "envelope.v1.json" }],
  "properties": {
    "event_type": { "const": "VideoProcessingCompleted" },
    "schema_version": { "const": 1 },
    "producer": { "const": "media-worker" },
    "aggregate_type": { "const": "video" },
    "payload": {
      "allOf": [{ "$ref": "common.v1.json#/$defs/jobRef" }],
      "unevaluatedProperties": false,
      "required": ["duration_ms", "source", "renditions", "master_playlist_key", "thumbnails"],
      "properties": {
        "duration_ms": { "type": "integer", "minimum": 1 },
        "source": {
          "description": "What the probe found in the original (display dimensions, after rotation).",
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height", "frame_rate", "has_audio"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "frame_rate": { "type": "number", "exclusiveMinimum": 0 },
            "has_audio": { "type": "boolean" }
          }
        },
        "renditions": { "type": "array", "minItems": 1, "items": { "$ref": "common.v1.json#/$defs/rendition" } },
        "master_playlist_key": { "type": "string", "minLength": 1 },
        "thumbnails": { "type": "array", "items": { "$ref": "common.v1.json#/$defs/thumbnail" } }
      }
    }
  }
}
