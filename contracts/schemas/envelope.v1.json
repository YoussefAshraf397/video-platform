{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.video-platform.internal/envelope.v1.json",
  "title": "Message envelope",
  "description": "Wraps every event and command exchanged between services (ADR-005).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id", "event_type", "schema_version", "occurred_at", "producer",
    "aggregate_type", "aggregate_id", "aggregate_version", "trace_id", "payload"
  ],
  "properties": {
    "event_id": { "$ref": "common.v1.json#/$defs/uuid", "description": "Unique per message; consumers deduplicate on it." },
    "event_type": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]+$" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "occurred_at": { "$ref": "common.v1.json#/$defs/timestamp" },
    "producer": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "aggregate_type": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "aggregate_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "aggregate_version": { "type": "integer", "minimum": 0, "description": "Lets consumers drop stale events for an aggregate." },
    "trace_id": { "type": ["string", "null"] },
    "payload": { "type": "object" }
  }
}
